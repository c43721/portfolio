---
import Head from "../components/Head.astro";
import Header from "../components/Header.astro";
import Water from "../components/Water.svelte";
import Footer from "../components/Footer.svelte";

const { ...props } = Astro.props;
---
<html>
  <head>
    <Head {...props} />
  </head>
  <body>
<Header />
    <slot />
<Water client:load />
<Footer />
  </body>
</html>
